# Production Environment Configuration
# Copy this file to .env and update the values

# GitHub Repository (for GHCR)
GITHUB_REPOSITORY=your-username/keuzekompas

# Image tag to use (main, develop, or version tag)
IMAGE_TAG=main

# Database Configuration
MONGO_USERNAME=admin
MONGO_PASSWORD=your-secure-password-here
MONGO_DATABASE=keuzekompas

# API Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
SALT_ROUNDS=12

# Port Configuration
API_PORT=3000
FRONTEND_PORT=80

# Optional: MongoDB Connection String (if using external MongoDB)
# MONGO_URI=mongodb://username:password@host:port/database